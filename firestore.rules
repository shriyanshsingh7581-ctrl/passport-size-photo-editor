rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             (request.auth.token.email == 'shriyanshsingh7581@gmail.com' ||
              request.auth.token.email == 'liveonconnect@gmail.com' ||
              request.auth.token.email == 'Liveonconnect@gmail.com');
    }

    function isAdmin() {
      return isSignedIn() && (
        isBootstrapAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function hasAdminVaultSecret() {
      return 'adminVaultSecret' in incoming() &&
             incoming().adminVaultSecret is string &&
             incoming().adminVaultSecret.size() <= 100 &&
             incoming().adminVaultSecret == 'MALNADU-ADMIN-VAULT-2026-SYNC';
    }

    function userExists(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // 3. Entity Validation Blueprints (Anti-Update-Gap)
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'phone', 'role', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'uid', 'userId', 'loginPassword', 'displayName', 'email', 'phone',
               'role', 'status', 'credits', 'freeCreditsClaimed', 'deviceFingerprint',
               'adminVaultSecret', 'createdAt', 'updatedAt'
             ]) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
             (!('userId' in data) || (data.userId is string && data.userId.size() >= 0 && data.userId.size() <= 60)) &&
             (!('loginPassword' in data) || (data.loginPassword is string && data.loginPassword.size() >= 0 && data.loginPassword.size() <= 100)) &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 150 &&
             data.phone is string && data.phone.size() >= 0 && data.phone.size() <= 30 &&
             data.role is string && (data.role == 'user' || data.role == 'admin') &&
             data.status is string && (
               data.status == 'pending' ||
               data.status == 'approved' ||
               data.status == 'active' ||
               data.status == 'blocked' ||
               data.status == 'removed' ||
               data.status == 'suspended'
             ) &&
             (!('credits' in data) || (data.credits is int && data.credits >= 0 && data.credits <= 1000000)) &&
             (!('freeCreditsClaimed' in data) || (data.freeCreditsClaimed is bool)) &&
             (!('deviceFingerprint' in data) || (data.deviceFingerprint is string && data.deviceFingerprint.size() >= 0 && data.deviceFingerprint.size() <= 128)) &&
             (!('adminVaultSecret' in data) || (data.adminVaultSecret is string && data.adminVaultSecret.size() >= 0 && data.adminVaultSecret.size() <= 100)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidSiteSettings(data) {
      return data.keys().hasAll([
               'brandName', 'brandTagline', 'logoType', 'logoText', 'logoUrl',
               'faviconUrl', 'primaryColor', 'secondaryColor', 'footerCredit',
               'seoTitle', 'seoDescription', 'enablePassportStudio', 'enableBgRemover',
               'enableClarityEnhancer', 'enableQrGenerator', 'enableLinkShortener', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'brandName', 'brandTagline', 'logoType', 'logoText', 'logoUrl',
               'faviconUrl', 'primaryColor', 'secondaryColor', 'footerCredit',
               'seoTitle', 'seoDescription', 'enablePassportStudio', 'enableBgRemover',
               'enableClarityEnhancer', 'enableQrGenerator', 'enableLinkShortener',
               'enableStudioToolsCategory', 'enableAkshayaToolsCategory', 'enableMediaLiveToolsCategory',
               'contactPhone', 'adminCreditPool', 'studioWalletCredits', 'adminVaultSecret',
               'enableFreeSignupCredits', 'freeSignupCreditsAmount', 'toolCatalog', 'customPosterTemplates', 'updatedAt'
             ]) &&
             (!('adminCreditPool' in data) || (data.adminCreditPool is int && data.adminCreditPool >= 0 && data.adminCreditPool <= 10000000)) &&
             (!('studioWalletCredits' in data) || (data.studioWalletCredits is int && data.studioWalletCredits >= 0 && data.studioWalletCredits <= 10000000)) &&
             (!('adminVaultSecret' in data) || (data.adminVaultSecret is string && data.adminVaultSecret.size() >= 0 && data.adminVaultSecret.size() <= 100)) &&
             (!('enableFreeSignupCredits' in data) || (data.enableFreeSignupCredits is bool)) &&
             (!('freeSignupCreditsAmount' in data) || (data.freeSignupCreditsAmount is int && data.freeSignupCreditsAmount >= 0 && data.freeSignupCreditsAmount <= 100)) &&
             data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 100 &&
             data.brandTagline is string && data.brandTagline.size() >= 0 && data.brandTagline.size() <= 160 &&
             data.logoType is string && (data.logoType == 'svg' || data.logoType == 'url') &&
             data.logoText is string && data.logoText.size() >= 0 && data.logoText.size() <= 10 &&
             data.logoUrl is string && data.logoUrl.size() >= 0 && data.logoUrl.size() <= 500 &&
             data.faviconUrl is string && data.faviconUrl.size() >= 0 && data.faviconUrl.size() <= 500 &&
             data.primaryColor is string && data.primaryColor.size() >= 4 && data.primaryColor.size() <= 20 &&
             data.secondaryColor is string && data.secondaryColor.size() >= 4 && data.secondaryColor.size() <= 20 &&
             data.footerCredit is string && data.footerCredit.size() >= 1 && data.footerCredit.size() <= 300 &&
             data.seoTitle is string && data.seoTitle.size() >= 1 && data.seoTitle.size() <= 160 &&
             data.seoDescription is string && data.seoDescription.size() >= 1 && data.seoDescription.size() <= 320 &&
             data.enablePassportStudio is bool &&
             data.enableBgRemover is bool &&
             data.enableClarityEnhancer is bool &&
             data.enableQrGenerator is bool &&
             data.enableLinkShortener is bool &&
             data.updatedAt is timestamp;
    }

    function isValidShortLink(data) {
      return data.keys().hasAll([
               'slug', 'originalUrl', 'createdBy', 'creatorEmail',
               'active', 'clicks', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'slug', 'originalUrl', 'shortUrl', 'createdBy', 'creatorEmail',
               'active', 'clicks', 'createdAt', 'updatedAt'
             ]) &&
             data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 60 && data.slug.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.originalUrl is string && data.originalUrl.size() >= 4 && data.originalUrl.size() <= 2000 &&
             (!('shortUrl' in data) || (data.shortUrl is string && data.shortUrl.size() >= 0 && data.shortUrl.size() <= 500)) &&
             data.createdBy is string && data.createdBy.size() >= 1 && data.createdBy.size() <= 128 &&
             data.creatorEmail is string && data.creatorEmail.size() >= 0 && data.creatorEmail.size() <= 150 &&
             data.active is bool &&
             data.clicks is int && data.clicks >= 0 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidAppointment(data) {
      return data.keys().hasAll([
               'userId', 'userName', 'userEmail', 'phone', 'serviceType',
               'countrySpec', 'branchLocation', 'appointmentDate', 'timeSlot',
               'status', 'notes', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'userName', 'userEmail', 'phone', 'serviceType',
               'countrySpec', 'branchLocation', 'appointmentDate', 'timeSlot',
               'status', 'notes', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 150 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
             data.serviceType is string && (
               data.serviceType == 'Passport Photo Shoot' ||
               data.serviceType == 'Visa Biometric Photo' ||
               data.serviceType == 'Express Document Verification' ||
               data.serviceType == 'OCI / PAN Card Photo' ||
               data.serviceType == 'Full Family Studio Package'
             ) &&
             data.countrySpec is string && data.countrySpec.size() >= 1 && data.countrySpec.size() <= 100 &&
             data.branchLocation is string && (
               data.branchLocation == 'Kochi Main Studio — MG Road' ||
               data.branchLocation == 'Trivandrum Technopark Center' ||
               data.branchLocation == 'Calicut Mavoor Road Studio' ||
               data.branchLocation == 'Online Express Verification'
             ) &&
             data.appointmentDate is string && data.appointmentDate.size() == 10 &&
             data.timeSlot is string && (
               data.timeSlot == '09:30 AM' ||
               data.timeSlot == '10:30 AM' ||
               data.timeSlot == '11:30 AM' ||
               data.timeSlot == '02:00 PM' ||
               data.timeSlot == '03:30 PM' ||
               data.timeSlot == '05:00 PM'
             ) &&
             data.status is string && (
               data.status == 'pending' ||
               data.status == 'confirmed' ||
               data.status == 'completed' ||
               data.status == 'cancelled'
             ) &&
             data.notes is string && data.notes.size() >= 0 && data.notes.size() <= 500 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidVerification(data) {
      return data.keys().hasAll([
               'userId', 'userName', 'userEmail', 'documentType', 'documentNumber',
               'country', 'photoPreviewDataUrl', 'status', 'remarks', 'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'userName', 'userEmail', 'documentType', 'documentNumber',
               'country', 'photoPreviewDataUrl', 'status', 'remarks', 'createdAt', 'updatedAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 100 &&
             data.userEmail is string && data.userEmail.size() >= 3 && data.userEmail.size() <= 150 &&
             data.documentType is string && (
               data.documentType == 'Indian Passport' ||
               data.documentType == 'PAN Card' ||
               data.documentType == 'Aadhaar Card' ||
               data.documentType == 'Driving License' ||
               data.documentType == 'UAE / Schengen Visa Form' ||
               data.documentType == 'OCI / Voter ID'
             ) &&
             data.documentNumber is string && data.documentNumber.size() >= 3 && data.documentNumber.size() <= 50 &&
             data.country is string && data.country.size() >= 2 && data.country.size() <= 80 &&
             data.photoPreviewDataUrl is string && data.photoPreviewDataUrl.size() >= 0 && data.photoPreviewDataUrl.size() <= 250000 &&
             data.status is string && (
               data.status == 'pending' ||
               data.status == 'under_review' ||
               data.status == 'verified' ||
               data.status == 'rejected'
             ) &&
             data.remarks is string && data.remarks.size() >= 0 && data.remarks.size() <= 500 &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    function isValidSavedPhoto(data) {
      return data.keys().hasAll([
               'userId', 'presetName', 'dimensionsText', 'bgColor', 'previewDataUrl', 'createdAt'
             ]) &&
             data.keys().hasOnly([
               'userId', 'presetName', 'dimensionsText', 'bgColor', 'previewDataUrl', 'createdAt'
             ]) &&
             data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 && data.userId.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.presetName is string && data.presetName.size() >= 1 && data.presetName.size() <= 100 &&
             data.dimensionsText is string && data.dimensionsText.size() >= 1 && data.dimensionsText.size() <= 80 &&
             data.bgColor is string && data.bgColor.size() >= 1 && data.bgColor.size() <= 30 &&
             data.previewDataUrl is string && data.previewDataUrl.size() >= 10 && data.previewDataUrl.size() <= 250000 &&
             data.createdAt is timestamp;
    }

    function isValidPaymentRequest(data) {
      return data.keys().hasAll([
               'id', 'clientName', 'clientContact', 'packageLabel',
               'creditsRequested', 'amountInr', 'utrNumber', 'status',
               'createdAt', 'updatedAt'
             ]) &&
             data.keys().hasOnly([
               'id', 'clientName', 'clientContact', 'userId', 'targetType',
               'packageLabel', 'creditsRequested', 'amountInr', 'utrNumber',
               'paymentNote', 'paymentScreenshotDataUrl', 'status', 'approvedCode',
               'adminVaultSecret', 'createdAt', 'processedAt', 'updatedAt'
             ]) &&
             data.id is string && data.id.size() >= 1 && data.id.size() <= 128 && data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
             data.clientName is string && data.clientName.size() >= 1 && data.clientName.size() <= 100 &&
             data.clientContact is string && data.clientContact.size() >= 1 && data.clientContact.size() <= 150 &&
             (!('userId' in data) || (data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128)) &&
             (!('targetType' in data) || (data.targetType == 'client_wallet' || data.targetType == 'admin_pool')) &&
             data.packageLabel is string && data.packageLabel.size() >= 1 && data.packageLabel.size() <= 80 &&
             data.creditsRequested is int && data.creditsRequested >= 1 && data.creditsRequested <= 1000000 &&
             data.amountInr is string && data.amountInr.size() >= 1 && data.amountInr.size() <= 40 &&
             data.utrNumber is string && data.utrNumber.size() >= 1 && data.utrNumber.size() <= 80 &&
             (!('paymentNote' in data) || (data.paymentNote is string && data.paymentNote.size() >= 0 && data.paymentNote.size() <= 300)) &&
             (!('paymentScreenshotDataUrl' in data) || (data.paymentScreenshotDataUrl is string && data.paymentScreenshotDataUrl.size() <= 350000)) &&
             data.status is string && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected') &&
             (!('approvedCode' in data) || (data.approvedCode is string && data.approvedCode.size() >= 0 && data.approvedCode.size() <= 60)) &&
             (!('processedAt' in data) || (data.processedAt is string && data.processedAt.size() >= 0 && data.processedAt.size() <= 60)) &&
             (!('adminVaultSecret' in data) || (data.adminVaultSecret is string && data.adminVaultSecret.size() >= 0 && data.adminVaultSecret.size() <= 100)) &&
             data.createdAt is timestamp &&
             data.updatedAt is timestamp;
    }

    // 4. Collection Rules

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if resource.data.status == 'approved' ||
                     resource.data.status == 'pending' ||
                     resource.data.status == 'active' ||
                     resource.data.status == 'blocked' ||
                     resource.data.status == 'removed' ||
                     resource.data.status == 'suspended' ||
                     (isSignedIn() && (resource.data.uid == request.auth.uid || isBootstrapAdmin()));

      allow create: if isValidId(userId) &&
                    isValidUser(incoming()) &&
                    incoming().uid == userId &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    (incoming().status == 'pending' || incoming().status == 'approved' || incoming().status == 'active' || incoming().status == 'blocked') &&
                    (
                      hasAdminVaultSecret() ||
                      isAdmin() ||
                      (isSignedIn() && userId == request.auth.uid && (
                        incoming().role == 'user' ||
                        (incoming().role == 'admin' && (isBootstrapAdmin() || incoming().email == 'malnadu.admin.vault@malnadumedia.com'))
                      ))
                    );

      allow update: if isValidId(userId) &&
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                    incoming().updatedAt == request.time &&
                    (
                      // Action 1: Owner updates displayName, phone, or deducts spent credits
                      (isOwner(userId) &&
                       incoming().email == existing().email &&
                       incoming().role == existing().role &&
                       incoming().status == existing().status &&
                       (!('credits' in incoming()) || !('credits' in existing()) || incoming().credits <= existing().credits) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'phone', 'credits', 'updatedAt'])) ||
                      // Action 2: Admin or Admin Vault Secret updates user profile and credits
                      ((isAdmin() || hasAdminVaultSecret()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'userId', 'loginPassword', 'displayName', 'email', 'phone',
                         'role', 'status', 'credits', 'freeCreditsClaimed', 'deviceFingerprint',
                         'adminVaultSecret', 'createdAt', 'updatedAt'
                       ]))
                    );

      allow delete: if isValidId(userId) && (isAdmin() || isBootstrapAdmin());
    }

    // PAYMENT REQUESTS COLLECTION
    match /paymentRequests/{requestId} {
      allow get: if isValidId(requestId);
      allow list: if resource.data.status == 'pending' ||
                     resource.data.status == 'approved' ||
                     resource.data.status == 'rejected' ||
                     (isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin()));

      allow create: if isValidId(requestId) &&
                    isValidPaymentRequest(incoming()) &&
                    incoming().id == requestId &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    (incoming().status == 'pending' || isAdmin() || hasAdminVaultSecret());

      allow update: if isValidId(requestId) &&
                    isValidPaymentRequest(incoming()) &&
                    incoming().id == existing().id &&
                    (incoming().createdAt == existing().createdAt || incoming().createdAt == request.time) &&
                    incoming().updatedAt == request.time &&
                    (isAdmin() || hasAdminVaultSecret()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'status', 'creditsRequested', 'targetType', 'approvedCode',
                      'processedAt', 'adminVaultSecret', 'createdAt', 'updatedAt'
                    ]);

      allow delete: if isValidId(requestId) && isAdmin();
    }

    // SITE SETTINGS COLLECTION
    match /siteSettings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if isSignedIn() && isBootstrapAdmin();

      allow create: if isValidId(settingId) &&
                    (isAdmin() || hasAdminVaultSecret()) &&
                    isValidSiteSettings(incoming()) &&
                    incoming().updatedAt == request.time;

      allow update: if isValidId(settingId) &&
                    (isAdmin() || hasAdminVaultSecret()) &&
                    isValidSiteSettings(incoming()) &&
                    incoming().updatedAt == request.time;

      allow delete: if isValidId(settingId) && isAdmin();
    }

    // SHORT LINKS COLLECTION
    match /shortLinks/{slug} {
      allow get: if isValidId(slug);
      allow list: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                    isValidId(slug) &&
                    isValidShortLink(incoming()) &&
                    incoming().slug == slug &&
                    incoming().createdBy == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time;

      allow update: if isSignedIn() &&
                    isValidId(slug) &&
                    isValidShortLink(incoming()) &&
                    incoming().slug == existing().slug &&
                    incoming().createdBy == existing().createdBy &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    (
                      (existing().createdBy == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'clicks', 'originalUrl', 'updatedAt'])) ||
                      (isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['active', 'clicks', 'originalUrl', 'updatedAt']))
                    );

      allow delete: if isValidId(slug) && isSignedIn() && (existing().createdBy == request.auth.uid || isAdmin());
    }

    // APPOINTMENTS COLLECTION
    match /appointments/{appointmentId} {
      allow get: if isValidId(appointmentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                    isValidId(appointmentId) &&
                    isValidAppointment(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    (incoming().status == 'pending' || isAdmin()) &&
                    userExists(request.auth.uid);

      allow update: if isSignedIn() &&
                    isValidId(appointmentId) &&
                    isValidAppointment(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    (
                      (existing().userId == request.auth.uid &&
                       existing().status != 'completed' &&
                       existing().status != 'cancelled' &&
                       (incoming().status == existing().status || incoming().status == 'cancelled') &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
                      (isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'appointmentDate', 'timeSlot', 'branchLocation', 'updatedAt']))
                    );

      allow delete: if isValidId(appointmentId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // DOCUMENT VERIFICATIONS COLLECTION
    match /verifications/{verificationId} {
      allow get: if isValidId(verificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                    isValidId(verificationId) &&
                    isValidVerification(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    incoming().updatedAt == request.time &&
                    (incoming().status == 'pending' || isAdmin()) &&
                    userExists(request.auth.uid);

      allow update: if isSignedIn() &&
                    isValidId(verificationId) &&
                    isValidVerification(incoming()) &&
                    incoming().userId == existing().userId &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    (
                      (existing().userId == request.auth.uid &&
                       existing().status == 'pending' &&
                       incoming().status == 'pending' &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['documentNumber', 'remarks', 'updatedAt'])) ||
                      (isAdmin() &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'remarks', 'updatedAt']))
                    );

      allow delete: if isValidId(verificationId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // SAVED PHOTOS COLLECTION
    match /savedPhotos/{photoId} {
      allow get: if isValidId(photoId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isBootstrapAdmin());

      allow create: if isSignedIn() &&
                    isValidId(photoId) &&
                    isValidSavedPhoto(incoming()) &&
                    incoming().userId == request.auth.uid &&
                    incoming().createdAt == request.time &&
                    userExists(request.auth.uid);

      allow update: if false;

      allow delete: if isValidId(photoId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
